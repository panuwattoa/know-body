# ── KnowBody API config ──
PORT=8080
ENV=local                     # local | prod

# Postgres (local docker default below; use the Supabase connection string in prod)
DATABASE_URL=postgres://knowbody:knowbody@localhost:5432/knowbody?sslmode=disable

# Supabase Auth — JWTs are HS256-signed with this project secret (Settings → API → JWT secret)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters
# In ENV=local you may set AUTH_DEV_BYPASS=1 to accept "Bearer dev:<uuid>" without a real JWT.
AUTH_DEV_BYPASS=1

# ── AI vision provider (food & body-scan analysis) ──
# Start free with Google Gemini; switch later by changing AI_PROVIDER=claude.
AI_PROVIDER=gemini            # gemini | claude

# Google Gemini — free tier. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic (Claude) — optional, for later. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cloudflare R2 (S3-compatible) — meal/body photos. Optional in local dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=knowbody-media

# Free-tier AI usage cap (photo food logs / month for non-Plus users)
FREE_AI_LOGS_PER_MONTH=3
