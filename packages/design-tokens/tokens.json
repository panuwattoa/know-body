{
  "$meta": {
    "name": "KnowBody design tokens",
    "source": "Fitness Pet Calorie Tracker handoff (Bloomfit) — turns 1–5",
    "description": "Single source of truth for color, type, radius, spacing. Consumed by Flutter (app/) and Next.js (web/). Regenerate platform files with packages/design-tokens/build.mjs."
  },
  "color": {
    "lime":        { "value": "#D8FB4F", "comment": "primary accent / calorie ring / CTAs" },
    "limeDeep":    { "value": "#A8C93A", "comment": "pet shading, secondary lime" },
    "limeStem":    { "value": "#8FA83A", "comment": "leaf stem / fine detail" },
    "limePale":    { "value": "#EDF7C4", "comment": "soft chip background" },
    "ink":         { "value": "#121212", "comment": "near-black text, dark pills" },
    "inkSoft":     { "value": "rgba(18,18,18,0.55)", "comment": "secondary text on light" },
    "inkFaint":    { "value": "rgba(18,18,18,0.40)", "comment": "tertiary / captions" },
    "bg":          { "value": "#EDEDE7", "comment": "app canvas" },
    "surface":     { "value": "#F6F6F2", "comment": "screen background inside frame" },
    "card":        { "value": "#FFFFFF", "comment": "elevated white cards" },
    "cardWarm":    { "value": "#FFFDF5", "comment": "warm white (pet belly, etc.)" },
    "dark":        { "value": "#0E120E", "comment": "dark hero cards / story bg" },
    "darkElev":    { "value": "#1E2A16", "comment": "raised dark green blob" },
    "darkNight":   { "value": "#1A2018", "comment": "lock-screen dark" },
    "onDark":      { "value": "#FFFFFF", "comment": "text on dark" },
    "onDarkSoft":  { "value": "rgba(255,255,255,0.55)", "comment": "secondary text on dark" },
    "accentText":  { "value": "#6E8B00", "comment": "positive trend text on light" },
    "accentDeep":  { "value": "#3F4A16", "comment": "text on pale-lime chips" },
    "petFur":      { "value": "#F4F1E6" },
    "petBelly":    { "value": "#FFFDF5" },
    "petNose":     { "value": "#E9A395" },
    "petEye":      { "value": "#20241D" },
    "petCheek":    { "value": "rgba(233,163,149,0.5)" },
    "hairline":    { "value": "rgba(18,18,18,0.08)", "comment": "1px dividers on light" },
    "danger":      { "value": "#E5484D", "comment": "over-budget / destructive" }
  },
  "font": {
    "family":   { "value": "Prompt", "fallback": "system-ui, -apple-system, sans-serif" },
    "weight": {
      "light":    { "value": 300 },
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    }
  },
  "type": {
    "display":  { "size": 34, "weight": 600, "lineHeight": 1.15, "letterSpacing": -0.6, "comment": "onboarding headline" },
    "title":    { "size": 24, "weight": 600, "lineHeight": 1.2,  "letterSpacing": -0.4 },
    "heading":  { "size": 17, "weight": 600, "lineHeight": 1.3 },
    "body":     { "size": 15, "weight": 400, "lineHeight": 1.5 },
    "label":    { "size": 13, "weight": 500, "lineHeight": 1.4 },
    "caption":  { "size": 12, "weight": 400, "lineHeight": 1.4 },
    "ringValue":{ "size": 38, "weight": 600, "lineHeight": 1.0, "letterSpacing": -1.0, "comment": "kcal-left number" }
  },
  "radius": {
    "chip":   { "value": 12 },
    "button": { "value": 18 },
    "pill":   { "value": 20 },
    "card":   { "value": 24 },
    "cardLg": { "value": 28 },
    "hero":   { "value": 36 },
    "full":   { "value": 999 }
  },
  "space": {
    "xs": { "value": 6 },
    "sm": { "value": 10 },
    "md": { "value": 14 },
    "lg": { "value": 20 },
    "xl": { "value": 24 },
    "2xl": { "value": 32 }
  },
  "shadow": {
    "card": { "value": "0 18px 40px rgba(0,0,0,0.16)" }
  }
}
